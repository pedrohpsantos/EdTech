{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "npm run lint:oxlint && eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "security-audit": "npm audit --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run --coverage --reporter=html --reporter=default",
    "test:a11y": "vitest run src/pages/__tests__/accessibility.test.jsx",
    "test:components": "vitest run src/components/",
    "lint:oxlint": "oxlint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\""
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.1",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.10",
    "allure-playwright": "^3.10.2",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
