        <vulnerabilityName>GHSA-gvmj-g25r-r7wr</vulnerabilityName>
        <vulnerabilityName>GHSA-vxr8-fq34-vvx9</vulnerabilityName>
        <vulnerabilityName>GHSA-x4vx-rjvf-j5p4</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing Kotlin Stdlib vulnerabilities coming from clamav-client
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib.*@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
        <cve>CVE-2020-29582</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing Jackson vulnerabilities
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-databind@.*$</packageUrl>
        <cve>CVE-2026-54515</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing HTTPCore CVE-2026-54399 and CVE-2026-54428
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@.*$</packageUrl>
        <cve>CVE-2026-54399</cve>
        <cve>CVE-2026-54428</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Suppressing Tika vulnerabilities (CVE-2026-66756, CVE-2026-66755)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tika/tika-core@.*$</packageUrl>
        <cve>CVE-2026-66756</cve>
        <cve>CVE-2026-66755</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Suppressing log4j-api vulnerabilities pending fix]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2026-66299</cve>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>
</suppressions>
