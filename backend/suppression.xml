<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <notes><![CDATA[
        Suppressing unpatchable vulnerabilities in OpenTelemetry alpha dependencies pulled by GCP SDK.
        These are transient dependencies and the risk is accepted until GCP releases an updated BOM.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry\..*@.*$</packageUrl>
        <cve>CVE-2026-24051</cve>
        <cve>CVE-2026-39883</cve>
        <cve>CVE-2026-29181</cve>
        <cve>CVE-2026-39882</cve>
        <cve>CVE-2026-41178</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing Tomcat CVEs (CVE-2026-55276, CVE-2026-53434, CVE-2026-53404) for all tomcat-embed modules
        until Spring Boot updates its managed dependencies to a patched Tomcat version.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-.*@.*$</packageUrl>
        <cve>CVE-2026-55276</cve>
        <cve>CVE-2026-53434</cve>
        <cve>CVE-2026-53404</cve>
        <cve>CVE-2026-55955</cve>
        <cve>CVE-2026-55956</cve>
        <cve>CVE-2026-50229</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing CVE-2026-0994 for protobuf-java until a stable patch is available.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java.*@.*$</packageUrl>
        <cve>CVE-2026-0994</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing DOMPurify/Swagger-UI vulnerabilities as it is an embedded dependency.
        ]]></notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2024-45801</cve>
        <cve>CVE-2024-47875</cve>
        <cve>CVE-2025-26791</cve>
        <cve>CVE-2026-41240</cve>
        <cve>CVE-2026-41238</cve>
        <cve>CVE-2026-41239</cve>
        <cve>CVE-2026-49458</cve>
        <cve>CVE-2026-49459</cve>
        <cve>CVE-2026-49978</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing Jackson vulnerabilities
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-databind@.*$</packageUrl>
        <cve>CVE-2026-54515</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppressing HTTPCore CVE-2026-54399
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@.*$</packageUrl>
        <cve>CVE-2026-54399</cve>
    </suppress>
</suppressions>
