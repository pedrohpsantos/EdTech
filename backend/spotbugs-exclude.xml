<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore getter/setter exposure which is standard for JPA Entities and Spring
    Controllers/Services -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Ignore CT_CONSTRUCTOR_THROW in JwtService since throwing IllegalStateException is standard
    validation -->
    <Match>
        <Class name="com.edtech.service.JwtService" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>

    <!--
        NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE in Spring MVC controllers:
        Authentication is guaranteed non-null by Spring Security filter chain.
        SpotBugs 4.10+ flags Authentication.getName() as potentially null
        but at runtime these endpoints are always behind authentication guards.
    -->
    <Match>
        <Or>
            <Class name="com.edtech.controller.DocumentController" />
            <Class name="com.edtech.controller.ProjectController" />
            <Class name="com.edtech.controller.DashboardController" />
            <Class name="com.edtech.controller.AuditController" />
            <Class name="com.edtech.controller.AuthController" />
        </Or>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>

    <!--
        NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE in EmailService:
        SimpleMailMessage.getTo() is always set explicitly before access.
    -->
    <Match>
        <Class name="com.edtech.service.EmailService" />
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>

    <!-- Ignore DM_EXIT in MigrationExitRunner since it is explicitly designed to exit the JVM after
    migration -->
    <Match>
        <Class name="com.edtech.config.MigrationExitRunner" />
        <Bug pattern="DM_EXIT" />
    </Match>
</FindBugsFilter>