# Template de Variáveis de Ambiente (.env.example)
# A documentação dos requisitos cita infraestruturas que precisam destas chaves:

# Configurações da API Backend (Python)
PORT=8000
ENVIRONMENT=development

# Conexão com o PostgreSQL (Isolamento de Projetos e Auditoria)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=edtech_unb

# Configuração JWT (Autenticação Segura RNF01.2)
JWT_SECRET_KEY=your_super_secret_jwt_signature_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Armazenamento GCS (Requisito Funcional RF02 - Upload PDFs)
GCP_PROJECT_ID=my-gcp-project-unb
GCP_STORAGE_BUCKET_NAME=edtech-unb-documents-bucket
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-credentials.json
