# Template de variaveis de ambiente do projeto.
# Para Docker Compose local, copie infra/.env.example para infra/.env.

# PostgreSQL local
POSTGRES_DB=edtech_db
POSTGRES_USER=edtech_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Backend Spring Boot
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edtech_db
SPRING_DATASOURCE_USERNAME=edtech_user
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Defina um valor local forte no arquivo .env real. Nao versione esse valor real.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
JWT_COOKIE_SECURE=false

# Armazenamento GCS
GCP_PROJECT_ID=my-gcp-project-unb
GCP_STORAGE_BUCKET_NAME=edtech-unb-documents-bucket
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-credentials.json
