{
  "info": {
    "name": "EdTech API",
    "description": "Coleção manual da API EdTech. O login estabelece um cookie HttpOnly; use o cookie jar do Postman em vez de copiar tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pesquisador.demo@unb.br\",\n  \"password\": \"Demo@1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Perfil da sessão atual",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Solicitar recuperação de senha",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pesquisador.demo@unb.br\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/recovery/request"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Projetos e documentos",
      "item": [
        {
          "name": "Listar projetos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects?page=0&size=20"
          }
        },
        {
          "name": "Listar documentos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/documents?page=0&size=20"
          }
        },
        {
          "name": "Enviar documento",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                {
                  "key": "title",
                  "type": "text",
                  "value": "Documento de teste"
                },
                { "key": "projectId", "type": "text", "value": "{{projectId}}" }
              ]
            },
            "url": "{{baseUrl}}/api/documents"
          }
        }
      ]
    },
    {
      "name": "Governança",
      "item": [
        {
          "name": "Listar auditoria (Auditor)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/audit-logs?page=0&size=20"
          }
        },
        {
          "name": "Exportar auditoria CSV (Auditor)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/audit-logs/export"
          }
        },
        {
          "name": "Gerar tokens de laboratório (Orientador)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/laboratory/token"
          }
        },
        {
          "name": "Vincular ao laboratório",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{laboratoryToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/laboratory/join"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "projectId", "value": "" },
    { "key": "laboratoryToken", "value": "" }
  ]
}
