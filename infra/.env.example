# Exemplo de configuracao para desenvolvimento local com Docker Compose.
# Copie para infra/.env e ajuste apenas o que for necessario.

POSTGRES_DB=edtech_db
POSTGRES_USER=edtech_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

BACKEND_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Defina um valor local forte em infra/.env. Nao versione esse valor real.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Configuração do Supabase S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<seu_projeto>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET_NAME=documents
