# ==========================================
# Configurações do Servidor
# ==========================================
SERVER_PORT=8080

# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edtech_db
SPRING_DATASOURCE_USERNAME=edtech_user
SPRING_DATASOURCE_PASSWORD=senha_super_segura
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ==========================================
# Autenticação (JWT)
# ==========================================
# Gere uma chave forte (ex: uma string aleatória de 64 caracteres)
JWT_SECRET=sua_chave_secreta_super_forte_e_longa_aqui_para_assinatura_jwt
JWT_EXPIRATION_MINUTES=60
JWT_COOKIE_SECURE=false # Mude para 'true' em produção (HTTPS)

# ==========================================
# CORS (Frontend)
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# Envio de E-mails (Ex: Mailtrap para dev)
# ==========================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=seu_usuario_mailtrap
SMTP_PASSWORD=sua_senha_mailtrap

# ==========================================
# Storage - Upload de Documentos
# ==========================================
# Opções válidas: 'gcs' (Google Cloud Storage) ou 's3' (AWS/Supabase)
STORAGE_PROVIDER=gcs

# --- Configuração Google Cloud Storage (se STORAGE_PROVIDER=gcs) ---
GCP_PROJECT_ID=edtech-500916
GCP_BUCKET_NAME=edtech-storage-seu-nome
# Caminho absoluto ou url (file:///) para o arquivo JSON da conta de serviço
GCP_CREDENTIALS_LOCATION=file:///C:/Users/pedrohpsantos/Caminho/Para/Sua/Chave.json

# --- Configuração S3 / Supabase (se STORAGE_PROVIDER=s3) ---
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
S3_ENDPOINT=https://abc.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET_NAME=documents
