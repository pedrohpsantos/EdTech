<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore getter/setter exposure which is standard for JPA Entities and Spring Controllers/Services -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    
    <!-- Ignore CT_CONSTRUCTOR_THROW in JwtService since throwing IllegalStateException is standard validation -->
    <Match>
        <Class name="com.edTech.service.JwtService" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
</FindBugsFilter>
